# ---------- LLM（必填）----------
LLM_BASE_URL=https://your-llm-endpoint/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=your-model-name

# ---------- 联网搜索（search_web 必填）----------
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# ---------- 天气（get_weather 必填）----------
HEFENG_API_HOST=your-subdomain.qweatherapi.com
HEFENG_API_KEY=xxxxxxxxxxxxxxxx

# ---------- 可选：行为开关 ----------
LLM_THINKING=disabled
INTERNAL_API_BASE=http://localhost:8001
# INTERNAL_API_TIMEOUT=10
# SEARCH_MAX_RESULTS=3

# 授权读取薪资等敏感列（默认脱敏；生产请交给权限系统，不要用环境变量一刀切）
# DB_SHOW_SALARY=1

# ---------- 可选：日志 ----------
# 担心日志含个人信息（用户原文、员工姓名/薪资）时可调到 WARNING
# LOG_LEVEL=INFO
# LOG_MAX_BYTES=2097152
# LOG_BACKUP_COUNT=3

# ---------- 可选：运行时路径（默认都在仓库内，容器里用得到）----------
# DATA_DIR=./data
# LOGS_DIR=./logs
# CHECKPOINT_DB=./checkpoints.db
# SENSITIVE_AUDIT_LOG=./logs/sensitive_ops.jsonl
